{
  // Type-checked with tsc, not tsrs (TS 7): expo/tsconfig.base's lib/target
  // settings make TS 7 report ~100 diagnostics tsc does not (bench 2026-10-21).
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@focusflow/validators": ["../../packages/validators/src/index.ts"],
      "@focusflow/mo/child": ["../../packages/mo/src/child.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
